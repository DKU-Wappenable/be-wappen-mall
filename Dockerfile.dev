# be-wappen-mall/Dockerfile.dev
FROM gradle:8.10.1-jdk21 AS builder

# 작업 디렉터리 설정
WORKDIR /app

# Docker CLI 설치 (root 권한으로)
USER root
RUN apt-get update && apt-get install -y --no-install-recommends docker.io
# docker-compose wrapper for Spring Boot: redirect to `docker compose`
RUN printf '#!/bin/sh\nexec docker compose "$@"\n' > /usr/local/bin/docker-compose \
    && chmod +x /usr/local/bin/docker-compose
# 기본 홈디렉터리(/home/gradle/.gradle) 사용하도록 변경
# RUN mkdir -p /app/.gradle /app/.gradle-home && chown -R gradle:gradle /app

# Gradle 홈 디렉토리 환경 변수 설정
ENV GRADLE_USER_HOME=/home/gradle/.gradle
# GRADLE 캐시 홈 디렉터리 생성 및 권한 설정
RUN mkdir -p $GRADLE_USER_HOME && chown -R gradle:gradle $GRADLE_USER_HOME

# Gradle Wrapper 및 설정 복사 (소유권을 gradle로 지정)
COPY --chown=gradle:gradle gradlew gradlew
COPY --chown=gradle:gradle gradle gradle
COPY --chown=gradle:gradle build.gradle settings.gradle ./
# 프로젝트 로컬 .gradle 폴더 생성 및 권한 설정
RUN mkdir -p /app/.gradle && chown -R gradle:gradle /app/.gradle

# 프로젝트 디렉터리 소유권을 gradle 사용자에게 변경
USER root
RUN chown -R gradle:gradle /app

# 원래 유저(gradle)로 복귀
USER gradle

# 실행 권한 및 의존성 캐싱
RUN chmod +x gradlew && ./gradlew dependencies --no-daemon

# 소스 복사
COPY src src

# 개발 서버 포트 노출
EXPOSE 8080

# Spring Boot 개발 모드 실행
CMD ["./gradlew", "-t", "bootRun", "--no-daemon"]